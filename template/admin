{% extends 'base.html' %}
{% block title %}Admin{% endblock %}
{% block content %}
<h4 class="mb-3">Pending claims</h4>
<div class="card mb-4"><div class="table-responsive">
<table class="table align-middle mb-0">
  <thead><tr><th>Item</th><th>Claimant</th><th>Proof provided</th><th></th></tr></thead>
  <tbody>
  {% for c in pending %}
  <tr>
    <td><a href="{{ url_for('item_detail', item_id=c['item_id']) }}">{{ c['title'] }}</a></td>
    <td>{{ c['claimant_name'] }}<br><small class="text-muted">{{ c['claimant_email'] }}</small></td>
    <td style="max-width:320px">{{ c['message'] }}</td>
    <td class="text-nowrap">
      <form method="post" action="{{ url_for('review_claim', claim_id=c['id'], action='approve') }}" class="d-inline"><button class="btn btn-sm btn-success">Approve</button></form>
      <form method="post" action="{{ url_for('review_claim', claim_id=c['id'], action='reject') }}" class="d-inline"><button class="btn btn-sm btn-outline-danger">Reject</button></form>
    </td>
  </tr>
  {% else %}<tr><td colspan="4" class="text-muted">No pending claims.</td></tr>{% endfor %}
  </tbody>
</table></div></div>

<h4 class="mb-3">All items</h4>
<div class="card"><div class="table-responsive">
<table class="table align-middle mb-0">
  <thead><tr><th>Type</th><th>Item</th><th>Reporter</th><th>Status</th><th></th></tr></thead>
  <tbody>
  {% for it in all_items %}
  <tr>
    <td><span class="badge {{ 'badge-lost' if it['type'] == 'lost' else 'badge-found' }}">{{ it['type']|upper }}</span></td>
    <td><a href="{{ url_for('item_detail', item_id=it['id']) }}">{{ it['title'] }}</a></td>
    <td>{{ it['owner_name'] }}</td><td>{{ it['status'] }}</td>
    <td><form method="post" action="{{ url_for('delete_item', item_id=it['id']) }}" onsubmit="return confirm('Delete this item?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td>
  </tr>
  {% endfor %}
  </tbody>
</table></div></div>
{% endblock %}
